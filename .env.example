# Copy this file to ".env" and edit the values.
PORT=3000

# --- MySQL (XAMPP defaults shown) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vidhisales
DB_USER=root
DB_PASS=

# --- Admin panel ---
# A long random string (used to sign admin login cookies). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Optional: the first admin account is created automatically on first start if these are set.
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe@12345

# Set to true when running behind a proxy/HTTPS (Nginx, Render, Railway...) so cookies are "secure".
BEHIND_PROXY=false
